# Database Configuration
# PostgreSQL connection string (Neon or other PostgreSQL provider)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# GitHub Personal Access Token
# Required for fetching contributions from GitHub API
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_PAT_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Cron Job Secret
# Used to authenticate cron job requests
# Generate a secure random string (at least 32 characters)
CRON_SECRET=your-secure-random-string-here

# Admin Init Token (REQUIRED FOR PRODUCTION SAFETY)
# Used to authenticate database initialization requests
# Without this, the /api/init endpoint will be disabled
# Generate a secure token: openssl rand -hex 32
ADMIN_INIT_TOKEN=your-secure-admin-token-here

# Production Safety Flags
# Set to 'production' on production deployments
NODE_ENV=development

# DANGEROUS: Only set this to 'true' if you really need to reinitialize production database
# This will allow dropping all tables in production
ALLOW_PRODUCTION_INIT=false

# Vercel Environment (automatically set by Vercel)
# VERCEL_ENV=production|preview|development